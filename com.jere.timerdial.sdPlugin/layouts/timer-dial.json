{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "timer-dial",
	"controller": "Encoder",
	"items": [
		{
			"key": "bg",
			"type": "text",
			"rect": [0, 0, 200, 100],
			"zOrder": 0,
			"value": "",
			"background": "#000000"
		},
		{
			"key": "title",
			"type": "text",
			"rect": [16, 6, 92, 22],
			"zOrder": 1,
			"font": { "size": 14, "weight": 600 },
			"alignment": "left",
			"text-overflow": "ellipsis"
		},
		{
			"key": "status",
			"type": "text",
			"rect": [112, 6, 72, 22],
			"zOrder": 1,
			"font": { "size": 12, "weight": 700 },
			"alignment": "right",
			"color": "#8E8E93",
			"value": "READY"
		},
		{
			"key": "time",
			"type": "text",
			"rect": [0, 30, 200, 40],
			"zOrder": 1,
			"font": { "size": 38, "weight": 700 },
			"alignment": "center",
			"value": "5:00"
		},
		{
			"key": "hint",
			"type": "text",
			"rect": [8, 71, 184, 15],
			"zOrder": 1,
			"font": { "size": 11, "weight": 500 },
			"alignment": "center",
			"color": "#8E8E93",
			"text-overflow": "ellipsis",
			"value": "Press to start"
		},
		{
			"key": "bar",
			"type": "bar",
			"rect": [16, 88, 168, 6],
			"zOrder": 1,
			"subtype": 4,
			"border_w": 0,
			"bar_bg_c": "#2C2C2E",
			"bar_fill_c": "#48484A",
			"value": 100,
			"range": { "min": 0, "max": 100 }
		}
	]
}
